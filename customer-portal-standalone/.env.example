# Copy to .env (local dev) or set in Vercel Project Settings > Environment Variables.
# All Vite env vars exposed to client code MUST be prefixed VITE_.

# Base URL of the deployed pulsenet-api backend (no trailing slash).
# Example: https://api.pulsenet.example.co.ke
# Leave unset only if this app is served from the same origin as the API
# (e.g. behind a reverse proxy that forwards /api/* to the backend).
VITE_API_BASE_URL=https://api.pulsenet.example.co.ke
